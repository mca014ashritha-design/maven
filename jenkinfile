pipeline {
    agent any
    environment {
        IMAGE_NAME = 'ashudockerhub/maven'
        CREDENTIALS = credentials('dockerId')  // Credentials used for DockerHub login
    }
    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/mca014ashritha-design/maven.git', credentialsId: 'dockerId'
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean package -DskipTests' // Fixed space
            }
        }

        stage('Build docker image') {
            steps {
                script {
                    dockerImage = docker.build("${IMAGE_NAME}")  // Proper use of the IMAGE_NAME environment variable
                }
            }
        }

        stage('Push') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', 'dockerId') {  // Docker registry login
                        dockerImage.push()  // Push the image to Docker Hub
                    }
                }
            }
        }
    }
}

